#code to create a menu driven file system

while True:
    print("File System Menu")
    print("1. Create a file.")
    print("2. Open a file.")
    print("3. Read a file.")
    print("4. Edit a file.")
    print("", end="\n")
    ch = int(input("Select an option: "))

    if ch == 1:
        print("\nCreating an empty file\n")
        _name_ = input("Enter a name for the file: ")
        with open(f"{_name_}.txt","x") as f:
            print(f"File by the name of {_name_} has been created.")

    elif ch == 2:
        print("\nOpening a file\n")
        _name_ = input("Enter a file name to open it: \n")
        with open(f"{_name_}.txt","r") as f:
            print("File has been opened.")
            print("now closing....\n")
    
    elif ch == 3:
        print("\nOpening Read Menu:\n")
        print("1. Open the whole file.")
        print("2. readline()")
        print("3. readlines()")

        
    


        
